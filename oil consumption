<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Monitoring Pemakaian Oli - BSS Site MBLM</title>
  
  <!-- CSS Framework & DataTables -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
  
  <style>
    body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .header-box { background-color: #0d6efd; color: white; padding: 20px; border-radius: 8px; margin-bottom: 25px; }
    .card { border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
  </style>
</head>
<body>

<div class="container my-4">
  <div class="header-box text-center">
    <h2 class="fw-bold mb-1">MONITORING PEMAKAIAN OLI ALAT BERAT</h2>
    <p class="mb-0">PT BSS - Site MBLM</p>
  </div>

  <div class="card p-4">
    <div class="table-responsive">
      <table id="oilTable" class="table table-striped table-hover align-middle width-100" style="width:100%">
        <thead class="table-dark">
          <tr>
            <th>Tanggal</th>
            <th>Unit ID</th>
            <th>Nama Oli</th>
            <th>Qty (Liter)</th>
            <th>Component</th>
          </tr>
        </thead>
        <tbody>
          <!-- Data akan dimuat otomatis dari data.json -->
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- JavaScript Libraries -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
  $(document).ready(function() {
    $('#oilTable').DataTable({
      "ajax": {
        "url": "data.json",
        "dataSrc": ""
      },
      "columns": [
        { "data": "tanggal" },
        { "data": "unit" },
        { "data": "oil_name" },
        { "data": "qty" },
        { "data": "component" }
      ],
      "order": [[ 0, "desc" ]],
      "language": {
        "search": "Cari Data:",
        "lengthMenu": "Tampilkan _MENU_ data per halaman",
        "info": "Menampilkan _START_ sampai _END_ dari _TOTAL_ data",
        "paginate": {
          "next": "Berikutnya",
          "previous": "Sebelumnya"
        }
      }
    });
  });
</script>

</body>
</html>
